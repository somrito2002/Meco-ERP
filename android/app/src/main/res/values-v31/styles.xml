<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31) launch theme.
      The system splash is configured to be a minimal solid background with
      NO icon/logo: the Meco logo is never shown statically before the
      Flutter particle-reveal animation starts. The launcher icon itself is
      unaffected (it stays @mipmap/ic_launcher in the manifest).
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
